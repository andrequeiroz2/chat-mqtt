# Copie para .env e ajuste se necessário ( .env não é versionado ).

# Porta MQTT no host (container escuta 1883 internamente)
MQTT_HOST_PORT=1883

# Worker / broker (PoC dev local)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_CLIENT_ID=mqtt-chat-worker
MQTT_KEEPALIVE=60
MQTT_CONNECT_TIMEOUT=30
MQTT_BACKOFF_INITIAL_SEC=1
MQTT_BACKOFF_MAX_SEC=30

# Persistência: log (dev) | firestore (produção / Firebase configurado)
WORKER_PERSIST_MODE=log

# Firebase (somente se WORKER_PERSIST_MODE=firestore)
# Coloque o JSON da conta de serviço em secrets/service-account.json (não versionado)
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=secrets/service-account.json

# API HTTP (worker embutido no lifespan)
API_HOST=127.0.0.1
API_PORT=8000

# Logging estruturado (pacote mqtt_chat.logging)
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_SERVICE_NAME=mqtt-chat
